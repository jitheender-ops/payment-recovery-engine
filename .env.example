# === Razorpay Credentials (Test Mode) ===
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Keys the HMAC on POST /risks — the merchant-pushed risk events (abandoned
# carts, halted subscriptions, overdue invoices, failed mandate debits) that
# the chasers hunt. Shared with the merchant's outbound webhook client; left
# empty, /risks rejects everything — the surface is closed until configured.
RISK_WEBHOOK_SECRET=
# Optional network-layer allowlist for POST /webhooks/razorpay — comma-separated
# IPs or CIDRs. Razorpay's security guidance recommends allowlisting their
# webhook source IPs as defence in depth; this is that, for a deployment with no
# firewall in front of it. EMPTY = OFF, unlike the secrets above: HMAC signature
# verification is the authenticator and is always on, and an allowlist that
# defaulted to closed would reject every real webhook. Get the current addresses
# from Razorpay — they change, so nothing is baked into the code.
WEBHOOK_IP_ALLOWLIST=
# Per-request HTTP timeout for the Razorpay SDK. `requests` has no default
# timeout, so without this a hung connection blocks a worker indefinitely.
RAZORPAY_TIMEOUT_SECONDS=10.0

# Keys the case_events hash chain (scripts/audit_chain.py --stamp/--verify).
# The stamping algorithm is public — this secret is the only thing an
# attacker with database write access cannot compute, so leaving it empty
# makes stamp/verify refuse rather than produce a forgeable chain.
# Rotate it only with a deliberate clear-and-restamp (see tests/test_audit_chain.py).
AUDIT_CHAIN_SECRET=

# === Voice recovery agent (POST /voice/turn) ===
# HMAC key the telephony provider signs callbacks with (X-Voice-Signature,
# hex sha256 over the raw body). Empty = the endpoint refuses everything.
VOICE_WEBHOOK_SECRET=
# Opt into the LLM answer path. Off = replies assembled verbatim from
# retrieved passages and case facts (extractive, zero-dependency).
VOICE_LLM_ENABLED=false
# Opt into queueing voice follow-up calls after a successful nudge.
# A call is the highest-friction touch the engine can make — needs the
# merchant's own DoT/TCPB registration and AI disclosure at call start.
# With it on, successful nudges write a voice_call_queue row the telephony
# leg claims via POST /voice/queue/claim (HMAC-signed, same secret).
VOICE_CHASER_ENABLED=false

# === LLM Provider ===
# Supported: "anthropic" or "openai". The "openai" branch talks to ANY
# OpenAI-compatible endpoint — set LLM_BASE_URL to redirect it.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxx
LLM_BASE_URL=
LLM_MODEL=claude-opus-5

# --- OpenRouter (Gemma, Llama, Qwen, ...) — cheapest way to run the eval ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-xxxxxxxxxxxxx     # your OpenRouter key goes here
# LLM_MODEL=google/gemma-4-31b-it           # ~$0.10/$0.34 per 1M
# LLM_MODEL=google/gemma-4-31b-it:free      # free, but rate-limited

# --- Local Ollama ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama                     # any non-empty string
# LLM_MODEL=llama3.1

# === Database ===
# Required by docker-compose (no default — compose refuses to start without it).
POSTGRES_PASSWORD=change_me_local_dev
DATABASE_URL=postgresql+asyncpg://recovery:recovery@localhost:5432/payment_recovery
# Sync URL for Alembic migrations
DATABASE_URL_SYNC=postgresql://recovery:recovery@localhost:5432/payment_recovery

# --- Deployed? You do not set these by hand ---
# render.yaml provisions a Render Postgres and injects its connection string
# into both variables above. They receive the SAME value on purpose: config.py
# gives each the driver it needs (+asyncpg for the app, plain for Alembic).
# Note that Render's FREE database is deleted 30 days after creation.
#
# --- Only if you point at a POOLED Postgres instead ---
# (Supabase Supavisor, PgBouncer, RDS Proxy — see the appendix in
#  docs/DEPLOY.md, which carries the Supabase version in full.)
#
# The pooler must be in SESSION mode, never TRANSACTION mode. The
# contact-limit guard in orchestrator._get_ledger holds a SELECT ... FOR
# UPDATE row lock, which only means anything while one transaction keeps one
# backend. Under transaction pooling two concurrent webhooks can both read
# "4 of 5 contacts used" and both send — silently, and only under load.
# On Supabase that is port 5432, not 6543.
#
# Then turn this on. It shrinks the async pool (the pooler is already the
# pool) and disables asyncpg's prepared-statement cache, which pooling breaks
# in a way that surfaces as an intermittent "prepared statement _asyncpg_stmt_N
# does not exist" rather than as a config error. See src/database.py.
# DB_BEHIND_POOLER=true

# === Application ===
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
# Logs every SQL statement WITH bound parameters — those include customer
# email/phone/VPA. Leave false unless debugging locally.
SQL_ECHO=false

# === API Access ===
# Guards /openapi.json once APP_ENV is not "development"; the Swagger/ReDoc UIs
# are off entirely there. Empty means DENY, never allow. Not used by the webhook
# route — Razorpay authenticates by HMAC over the body, not by a header.
#   openssl rand -hex 32
API_KEY=
# Gates the Streamlit dashboard. Empty means the dashboard refuses to render.
# run.sh generates one into .env if you leave it blank.
DASHBOARD_PASSWORD=

# === Guardrail Config ===
MAX_RETRIES_PER_PAYMENT=3
MAX_RETRIES_PER_CUSTOMER_24H=5
# In PAISE (₹50,000 = 5,000,000 paise). The old name said INR while the value
# was paise — one typo away from a ₹500 ceiling. AMOUNT_CEILING_INR still loads
# for existing deployments, but prefer the honest name.
AMOUNT_CEILING_PAISE=5000000
CONSENT_WINDOW_HOURS=72
MAX_NUDGES_PER_CUSTOMER_24H=2
RETRY_BLACKOUT_START_HOUR=23
RETRY_BLACKOUT_END_HOUR=7
# Quiet period after a customer-facing contact, multiplied by escalation
# level: 24h before the 2nd message, 48h before the 3rd.
ESCALATION_BACKOFF_HOURS=24
# ── Promises to pay ──────────────────────────────────────────────────────
# A promise breaks at due_at + grace (bank posting delays are real), the
# pre-due reminder fires once at due_at - 48h through the normal chase
# pipeline, and capture surfaces refuse promises beyond 14 days (kept rate
# decays with horizon) or past 3 promises per case (words that stopped
# predicting money must not park a case forever). Payment-plan instalments
# are exempt from the cap — they are a validated set, not serial deferrals.
PROMISE_GRACE_HOURS=24
PROMISE_REMINDER_LEAD_HOURS=48
PROMISE_MAX_HORIZON_DAYS=14
MAX_PROMISES_PER_CASE=3

# === Dashboard ===
STREAMLIT_PORT=8501

# ── Customer recovery page ───────────────────────────────────────────────
# Signs the /recover/<token> links customers open. Dedicated secret, NOT the
# webhook one. Empty = the page is off and every token is rejected.
#   openssl rand -hex 32
RECOVERY_LINK_SECRET=
# Absolute origin customers reach you on, e.g. https://pay.yourdomain.in
# Without it the outbound message falls back to the plain payment link.
PUBLIC_BASE_URL=
# How long a /recover/<token> link stays alive, in hours. The URL is a bearer
# credential in SMS logs and browser history, so keep it short — every nudge
# mints a fresh link. Capped at CONSENT_WINDOW_HOURS regardless.
RECOVERY_LINK_TTL_HOURS=24
# Set true ONLY behind a reverse proxy you control (Render's LB, nginx, ALB).
# The recovery page's rate limits then key on the RIGHTMOST X-Forwarded-For
# entry (the one your proxy added). Left false, the header is ignored and the
# socket peer is used — correct for a direct docker deployment, where the
# header would otherwise be attacker-controlled.
BEHIND_TRUSTED_PROXY=false
# How many proxies YOU control sit in front of the app. The client IP is read
# this many entries from the RIGHT of X-Forwarded-For, since each trusted hop
# appends the peer it saw. 1 is a bare Render/ALB/nginx. Set 2 if a CDN sits
# in front of that — get it too low there and the rightmost entry is a
# constant internal address, so every visitor shares one rate-limit bucket and
# the limit turns into a denial of service. Ignored unless the flag above is
# true. Count the hops on the real deployment; do not guess.
TRUSTED_PROXY_HOPS=1

# ── Merchant identity & support ──────────────────────────────────────────
# Your display name — the trust anchor on the recovery page and in SMS.
# An unnamed link asking for money reads as phishing.
MERCHANT_NAME=
# Optional WhatsApp support number, digits only with country code (wa.me
# format), e.g. 919876543210. Shows a "Talk to us on WhatsApp" button.
SUPPORT_WHATSAPP=

# ── B2B receivables chaser ────────────────────────────────────────────────
# The writeback drain: where the engine POSTs HMAC-signed alerts (promise
# made/broken, dispute opened, plan defaulted, external payment recorded,
# chase exhausted) so your ERP reacts without watching a console. Signed
# with the SAME RISK_WEBHOOK_SECRET you sign your /risks pushes with — one
# identity, both directions. Empty = outbound leg off; alerts stay queued
# and visible on the console's Receivables alerts panel.
MERCHANT_WEBHOOK_URL=

# ── PII pseudonymisation ─────────────────────────────────────────────────
# Keys the HMAC that masks customer emails/phones before they reach the LLM.
# Dedicated secret, NOT the webhook one (one leak must not unmask customers).
# Empty falls back to the webhook secret for pre-existing deployments.
#   openssl rand -hex 32
PII_MASK_SECRET=
# Sarvam AI — STT (saaras:v3) + TTS (bulbul:v2) for the voice demo and audio-capable providers
SARVAM_API_KEY=

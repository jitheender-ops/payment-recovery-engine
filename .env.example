# === Razorpay Credentials (Test Mode) ===
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Per-request HTTP timeout for the Razorpay SDK. `requests` has no default
# timeout, so without this a hung connection blocks a worker indefinitely.
RAZORPAY_TIMEOUT_SECONDS=10.0

# === LLM Provider ===
# Supported: "anthropic" or "openai". The "openai" branch talks to ANY
# OpenAI-compatible endpoint — set LLM_BASE_URL to redirect it.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxx
LLM_BASE_URL=
LLM_MODEL=claude-opus-5

# --- OpenRouter (Gemma, Llama, Qwen, ...) — cheapest way to run the eval ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-xxxxxxxxxxxxx     # your OpenRouter key goes here
# LLM_MODEL=google/gemma-4-31b-it           # ~$0.10/$0.34 per 1M
# LLM_MODEL=google/gemma-4-31b-it:free      # free, but rate-limited

# --- Local Ollama ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama                     # any non-empty string
# LLM_MODEL=llama3.1

# === Database ===
# Required by docker-compose (no default — compose refuses to start without it).
POSTGRES_PASSWORD=change_me_local_dev
DATABASE_URL=postgresql+asyncpg://recovery:recovery@localhost:5432/payment_recovery
# Sync URL for Alembic migrations
DATABASE_URL_SYNC=postgresql://recovery:recovery@localhost:5432/payment_recovery

# === Application ===
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Logs every SQL statement WITH bound parameters — those include customer
# email/phone/VPA. Leave false unless debugging locally.
SQL_ECHO=false

# === API Access ===
# Guards /openapi.json once APP_ENV is not "development"; the Swagger/ReDoc UIs
# are off entirely there. Empty means DENY, never allow. Not used by the webhook
# route — Razorpay authenticates by HMAC over the body, not by a header.
#   openssl rand -hex 32
API_KEY=
# Gates the Streamlit dashboard. Empty means the dashboard refuses to render.
# run.sh generates one into .env if you leave it blank.
DASHBOARD_PASSWORD=

# === Guardrail Config ===
MAX_RETRIES_PER_PAYMENT=3
MAX_RETRIES_PER_CUSTOMER_24H=5
AMOUNT_CEILING_INR=5000000
CONSENT_WINDOW_HOURS=72
MAX_NUDGES_PER_CUSTOMER_24H=2
RETRY_BLACKOUT_START_HOUR=23
RETRY_BLACKOUT_END_HOUR=7

# === Dashboard ===
STREAMLIT_PORT=8501
